{
  "expo": {
    "name": "A.T.O.M.",
    "slug": "atom",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atom.assistant"
    },
    "android": {
      "package": "com.atom.assistant",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#05060a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["com.android.alarm.permission.SET_ALARM"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#05060a",
    "plugins": [
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "อนุญาตให้ $(PRODUCT_NAME) ใช้ไมโครโฟนเพื่อฟังคำสั่งเสียง",
          "enableBackgroundRecording": true
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "อนุญาตให้ $(PRODUCT_NAME) ใช้ไมโครโฟนเพื่อคุยด้วยเสียงสด"
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "อนุญาตให้ $(PRODUCT_NAME) ใช้ไมโครโฟนเพื่อคุยด้วยเสียงสด",
          "iosBackgroundMode": false,
          "androidPermissions": [
            "android.permission.RECORD_AUDIO",
            "android.permission.MODIFY_AUDIO_SETTINGS"
          ],
          "androidForegroundService": false,
          "disableFFmpeg": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "อนุญาตให้ $(PRODUCT_NAME) ใช้ไมโครโฟนเพื่อฟังคำสั่งเสียง",
          "speechRecognitionPermission": "อนุญาตให้ $(PRODUCT_NAME) แปลงเสียงพูดเป็นข้อความ",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      "onnxruntime-react-native",
      "expo-asset",
      "./plugins/withCleartextTraffic",
      "./plugins/withAndroidProjectName",
      [
        "expo-calendar",
        {
          "calendarPermission": "อนุญาตให้ $(PRODUCT_NAME) อ่านและเพิ่มนัดหมายในปฏิทิน",
          "remindersPermission": "อนุญาตให้ $(PRODUCT_NAME) จัดการเตือนความจำ"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "อนุญาตให้ $(PRODUCT_NAME) ค้นหารายชื่อเพื่อโทรหรือส่งข้อความ"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "อนุญาตให้ $(PRODUCT_NAME) ใช้ตำแหน่งเพื่อบอกอากาศและค้นหาสถานที่ใกล้ตัว"
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "อนุญาตให้ $(PRODUCT_NAME) ใช้กล้องเพื่อดูและอ่านสิ่งที่คุณถ่าย",
          "photosPermission": "อนุญาตให้ $(PRODUCT_NAME) เลือกรูปภาพ"
        }
      ],
      "./plugins/withGregorianBuildLocale"
    ],
    "owner": "assadawut17",
    "extra": {
      "eas": {
        "projectId": "78a273fe-5a21-43fb-b184-2eb408cf1290"
      }
    }
  }
}
