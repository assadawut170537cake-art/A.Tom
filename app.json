{
  "expo": {
    "name": "A.T.O.M.",
    "slug": "atom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.atom.assistant",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#05060a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#05060a",
    "plugins": [
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "อนุญาตให้ $(PRODUCT_NAME) ใช้ไมโครโฟนเพื่อฟังคำสั่งเสียง"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "อนุญาตให้ $(PRODUCT_NAME) เลือกรูปเพื่อส่งให้ผู้ช่วยดู",
          "cameraPermission": "อนุญาตให้ $(PRODUCT_NAME) ใช้กล้องถ่ายรูปเพื่อส่งให้ผู้ช่วยดู",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "อนุญาตให้ $(PRODUCT_NAME) ดูและเพิ่มนัดในปฏิทินตามที่บอสสั่ง",
          "remindersPermission": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "อนุญาตให้ $(PRODUCT_NAME) ค้นรายชื่อเพื่อโทรหรือส่งข้อความตามที่บอสสั่ง"
        }
      ],
      "expo-asset",
      "./plugins/withCleartextTraffic",
      "./plugins/withAndroidProjectName"
    ]
  }
}
