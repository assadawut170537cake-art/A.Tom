<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- เปิดแอปตามชื่อ ("เปิดแอป LINE") — Android 11+ ต้องประกาศว่าจะมองหาแอปที่มีหน้า launcher -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application>
    <!-- ADR-015 ระดับ B · บอสต้องเปิดเองที่ ตั้งค่า › การช่วยเหลือพิเศษ · exported=false + permission ของระบบ = มีแต่ OS ที่ผูกได้ -->
    <service
      android:name="expo.modules.atomdevice.AtomAccessibilityService"
      android:exported="false"
      android:label="@string/atom_accessibility_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/atom_accessibility_service" />
    </service>
  </application>
</manifest>
