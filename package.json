{
  "name": "atom",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "expo": "~57.0.28",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-calendar": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-contacts": "~57.0.8",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "lucide-react-native": "^1.56.0",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.15",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(?:(?:jest-)?react-native|@react-native(?:-community)?|expo(?:nent)?|@expo(?:nent)?/|@expo-google-fonts/|react-navigation|@react-navigation/|lucide-react-native|nativewind|react-native-css-interop))"
    ],
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    },
    "collectCoverageFrom": [
      "src/core/**/*.ts",
      "src/modules/**/*.ts",
      "src/dev/**/*.ts",
      "src/boot.ts",
      "src/features/ai/**/*.ts",
      "src/features/voice/**/*.ts",
      "src/features/router/**/*.ts",
      "src/features/memory/**/*.ts",
      "src/features/memory/**/*.tsx",
      "src/features/marketplace/**/*.ts",
      "src/features/marketplace/**/*.tsx",
      "src/features/jarvis/stores/useAtomStore.ts",
      "src/features/jarvis/services/**/*.ts",
      "src/features/settings/**/*.tsx",
      "!src/**/types.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 70,
        "branches": 70,
        "functions": 70,
        "lines": 70
      }
    }
  }
}
