# คัดลอกเป็น mark55/.env แล้วใส่ค่าจริง — .env อยู่ใน .gitignore ห้าม commit และห้ามแปะในแชท

# Supabase → Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
# service_role key: สิทธิ์เต็ม (ข้าม RLS) — ใช้บน Mark 55 เท่านั้น ห้ามใส่ในแอปมือถือ
SUPABASE_KEY=
# anon key: สำรองไว้ให้แอปมือถือ (4.5.5.3) — Mark 55 ไม่ใช้
SUPABASE_ANON_KEY=

# ไม่ใส่ = ใช้ค่าเริ่มต้น
# MARK55_NODE_ID=MARK_55_PC
# MARK55_CONTAINER_TAG=atom_core
# MARK55_POLL_INTERVAL=2.0
# MARK55_LOG_LEVEL=INFO

# NotebookLM Enterprise (มือถือ: "ส่งเข้า NotebookLM: …") — ต้อง `gcloud auth login` บน PC นี้ก่อน
# project id หรือ number ก็ได้ · ไม่ใส่ = ปิด
# NOTEBOOKLM_PROJECT=gen-lang-client-0240578036
# NOTEBOOKLM_LOCATION=global
# NOTEBOOKLM_NOTEBOOK_ID=   # ไม่ใส่ = สร้าง notebook ใหม่ครั้งแรกแล้วจำไว้ที่ ~/.mark55/notebooklm.json
